# Zabbix 只读控制台 · nginx 反向代理示例
#
# 为什么需要它：本工具**没有内置认证**，任何能访问端口的人都能看到全部监控数据。
# nginx 提供 HTTPS + Basic Auth 是最小成本的保护。
#
# 放置：/etc/nginx/conf.d/zbx-console.conf
# 生成密码：htpasswd -c /etc/nginx/.htpasswd ops
# 检查：nginx -t && systemctl reload nginx

upstream zbx_console {
    # 对应 docker-compose 里绑定的宿主机回环端口
    server 127.0.0.1:8770;
    keepalive 8;
}

server {
    listen 80;
    server_name zbx-console.internal;
    # 强制跳 HTTPS（证书就绪后取消注释）
    # return 301 https://$host$request_uri;

    # ---------- 未启用 HTTPS 时的最小保护 ----------
    auth_basic           "Zabbix Console";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # 只允许内网段访问（按实际改）
    # allow 10.51.0.0/16;
    # allow 192.168.0.0/16;
    # deny  all;

    client_max_body_size 2m;

    location / {
        proxy_pass         http://zbx_console;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # 关键：Zabbix 大范围取数可能较慢，默认 60s 容易 504
        proxy_connect_timeout 10s;
        proxy_send_timeout    180s;
        proxy_read_timeout    180s;

        # 不开 gzip 也行；开了首屏更快（app.js 141 KB）
        gzip on;
        gzip_types text/css application/javascript application/json;
        gzip_min_length 1024;
    }

    # 健康检查不需要认证，方便探针
    location = /api/ping {
        auth_basic off;
        proxy_pass http://zbx_console;
        access_log off;
    }
}

